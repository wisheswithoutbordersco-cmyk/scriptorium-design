# ---------------------------------------------------------------------------
# Scriptorium Production Studio — Customer Edition
# Copy to `.env` for local development. In production these are set in Railway.
# ---------------------------------------------------------------------------

# Clerk authentication (replaces the previous internal OAuth system).
# Backend verification:
CLERK_SECRET_KEY=sk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx
# Frontend, injected at BUILD time by Vite — must be present when `vite build` runs:
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# PostgreSQL connection string used by Drizzle (`drizzle-orm/node-postgres`).
DATABASE_URL=postgresql://user:password@host:5432/database

# Clerk user id (user_...) that should be granted the `admin` role on sign-in.
OWNER_OPEN_ID=

# Image generation providers.
OPENAI_API_KEY=
FAL_KEY=

# Built-in file storage (presigned uploads for generated pages and PDFs).
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Optional analytics placeholders referenced by client/index.html.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Railway sets PORT automatically; only needed for local overrides.
PORT=3000
